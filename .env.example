# RevenueCat Google Play public SDK key. Never put a secret key in the app.
VITE_REVENUECAT_ANDROID_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=My Vision Pro
# Replace these examples with the package identifiers in your RevenueCat default offering.
VITE_REVENUECAT_MONTHLY_PACKAGE_ID=$monthly
VITE_REVENUECAT_YEARLY_PACKAGE_ID=$annual
