{
  "name": "aetherion",
  "version": "0.2.0",
  "description": "AETHERION — procedural open-world action RPG for mobile (TypeScript + Three.js + Android WebView)",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:logic && npm run test:sim",
    "test:logic": "esbuild tests/run.ts --bundle --platform=node --format=esm --outfile=.tmp/tests.mjs --log-level=error && node .tmp/tests.mjs",
    "test:sim": "esbuild tests/sim.ts --bundle --platform=node --format=esm --outfile=.tmp/sim.mjs --log-level=error && node .tmp/sim.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eraslan19j/Agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eraslan19j/Agent/issues"
  },
  "homepage": "https://github.com/eraslan19j/Agent#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
