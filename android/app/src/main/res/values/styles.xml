<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/myvision_yellow</item>
        <item name="colorPrimaryDark">@color/myvision_background</item>
        <item name="colorAccent">@color/myvision_yellow</item>
        <item name="android:windowBackground">@color/myvision_background</item>
        <item name="android:statusBarColor">@color/myvision_background</item>
        <item name="android:navigationBarColor">@color/myvision_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/myvision_background</item>
        <item name="android:windowBackground">@color/myvision_background</item>
        <item name="android:statusBarColor">@color/myvision_background</item>
        <item name="android:navigationBarColor">@color/myvision_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/myvision_background</item>
        <item name="android:statusBarColor">@color/myvision_background</item>
        <item name="android:navigationBarColor">@color/myvision_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
