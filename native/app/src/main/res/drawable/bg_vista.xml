<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F20B1220"
                android:centerColor="#E6080C14"
                android:endColor="#FA04060B"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="620dp"
                android:centerX="0.72"
                android:centerY="0.22"
                android:startColor="#55A8D8FF"
                android:centerColor="#22708CC0"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
