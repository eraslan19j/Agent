<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blox_sky">

    <ai.aetherion.nativeapp.GameSurfaceView
        android:id="@+id/game"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ai.aetherion.nativeapp.HudView
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- in-game bar -->
    <LinearLayout
        android:id="@+id/hudTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/coinText"
            style="@style/BloxChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/20" />

        <TextView
            android:id="@+id/timeText"
            style="@style/BloxChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:00" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/leaveBtn"
            style="@style/BloxChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu" />
    </LinearLayout>

    <!-- title screen -->
    <LinearLayout
        android:id="@+id/menuRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/menu_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.10"
            android:shadowColor="#55000000"
            android:shadowDy="6"
            android:shadowRadius="14"
            android:text="@string/title"
            android:textColor="@color/white"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="@string/tagline"
            android:textColor="@color/blox_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/playBtn"
            style="@style/BloxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/play" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/help"
            android:textColor="#CCEAF6FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/diagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxLines="6"
            android:text=""
            android:textColor="#FFFFE08A"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- win overlay -->
    <FrameLayout
        android:id="@+id/winRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3071A2E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_win"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="46dp"
            android:paddingTop="30dp"
            android:paddingEnd="46dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/win_title"
                android:textColor="@color/blox_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/win_sub"
                android:textColor="#AA152230"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/winTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:text=""
                android:textColor="@color/blox_blue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/againBtn"
                style="@style/BloxButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/again" />

            <TextView
                android:id="@+id/menuBtn"
                style="@style/BloxChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/chip_light"
                android:textColor="@color/blox_text"
                android:text="@string/menu" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
